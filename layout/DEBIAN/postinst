#!/bin/sh
#
# Что нужно сделать на самом устройстве после распаковки.
#
# До iOS 7 не требовалось ничего: SpringBoard сам обходил /Applications и
# запускал что найдёт. Дальше связку должен зарегистрировать LaunchServices,
# и без этого значок либо не появляется, либо появляется, но нажатие не даёт
# ничего — и в /var/mobile/Library/Logs/CrashReporter при этом пусто: падать
# нечему, процесс не заводят вовсе.
#
# Права выставляются ещё раз, хотя они правильные и в пакете: приложение могли
# ставить и распаковкой вручную, а связку с правами 777 система не примет.
set -e

APP=/Applications/KiraLegacy.app

if [ -d "$APP" ]; then
	chown -R root:wheel "$APP" 2>/dev/null || true

	find "$APP" -type d -exec chmod 755 {} + 2>/dev/null || true
	find "$APP" -type f -exec chmod 644 {} + 2>/dev/null || true
	chmod 755 "$APP/KiraLegacy" 2>/dev/null || true

	# Переподпись на устройстве — с теми же ключами, что и при сборке.
	#
	# Здесь была ловушка. Плоский «ldid -S» переподписывает файл именем,
	# выведенным из имени файла, а не из CFBundleIdentifier, и заодно снимает
	# признак adhoc — то есть ровно портит то, что Makefile выставлял
	# нарочно. Приезжает годная подпись, а после установки остаётся негодная,
	# и приложение молча не запускается.
	#
	# Смысл в переподписи всё же есть: часть джейлбрейков заносит в своё
	# хранилище доверия то, что подписано их же ldid. Поэтому вызов остаётся,
	# но с -Cadhoc и -I.
	#
	# Про сводки просить нечего: ldid на устройстве кладёт те, которые эта
	# система понимает, — старый только SHA-1, новый обе.
	#
	# Если ldid нет или он не понимает ключей, остаётся подпись из пакета,
	# а она годна и так: SHA-1 для iOS 5…10 и SHA-256 для iOS 11 и новее.
	if command -v ldid >/dev/null 2>&1; then
		ldid -Cadhoc -Iru.computershik.kiralegacy -S "$APP/KiraLegacy" 2>/dev/null || true
	fi
fi

# uicache есть не везде и называется по-разному; молчаливый отказ здесь не
# страшен — значок появится после перезапуска SpringBoard.
if command -v uicache >/dev/null 2>&1; then
	uicache 2>/dev/null || uicache -a 2>/dev/null || true
fi

exit 0
